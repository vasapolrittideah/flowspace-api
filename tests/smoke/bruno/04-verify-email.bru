meta {
  name: Verify email
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/email-verifications
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "code": "{{verificationCode}}"
  }
}

tests {
  test("the current code verifies the account", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().emailVerified).to.equal(true);
  });
}
