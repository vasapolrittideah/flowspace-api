meta {
  name: Reject refresh after device logout
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/v1/session-refreshes
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "refreshToken": "{{deviceRefreshToken}}"
  }
}

tests {
  test("the logged-out device cannot refresh", function () {
    expect(res.getStatus()).to.equal(401);
  });
}
