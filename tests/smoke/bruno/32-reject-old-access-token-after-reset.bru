meta {
  name: Reject old access token after reset
  type: http
  seq: 32
}

post {
  url: {{baseUrl}}/v1/email-verification-codes
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{recoveryAccessToken}}
}

body:json {
  {}
}

tests {
  test("the live session check rejects the unexpired old access token", function () {
    expect(res.getStatus()).to.equal(401);
  });
}
