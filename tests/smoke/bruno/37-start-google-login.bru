meta {
  name: Start Google login
  type: http
  seq: 37
}

post {
  url: {{baseUrl}}/v1/provider-login-attempts
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "provider": "PROVIDER_GOOGLE"
  }
}

tests {
  test("Identity returns a bound Google authorization URL and a separate attempt token", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(Object.keys(body).sort()).to.deep.equal(["attemptExpiresAt", "attemptToken", "authorizationUrl"]);
    expect(body.attemptToken).to.match(/^[A-Za-z0-9_-]{43}$/);
    const [endpoint, search] = body.authorizationUrl.split("?");
    expect(endpoint).to.equal("https://accounts.google.com/o/oauth2/v2/auth");
    const query = new Map(search.split("&").map((pair) => pair.split("=").map((part) => decodeURIComponent(part.replace(/\+/g, " ")))));
    expect(query.get("response_type")).to.equal("code");
    expect(query.get("redirect_uri")).to.equal("http://localhost:8082/v1/provider-login-callbacks/google");
    expect(query.get("scope")).to.equal("openid email");
    expect(query.get("code_challenge_method")).to.equal("S256");
    expect(query.get("code_challenge")).to.match(/^[A-Za-z0-9_-]{43}$/);
    expect(query.get("state")).to.match(/^[A-Za-z0-9_-]{43}$/);
    expect(query.has("nonce")).to.equal(true);
    expect(body.authorizationUrl).to.not.include(body.attemptToken);
    bru.setVar("googleAttemptToken", body.attemptToken);
    bru.setVar("googleState", query.get("state"));
  });
}
