meta {
  name: Re-authenticate with password
  type: http
  seq: 48
}

post {
  url: {{baseUrl}}/v1/password-reauthentications
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{reauthenticationAccessToken}}
}

body:json {
  {
    "password": "{{newPassword}}"
  }
}

tests {
  test("the correct password returns the end time of the open window", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(Object.keys(body)).to.deep.equal(["reauthenticationExpiresAt"]);
    const end = Date.parse(body.reauthenticationExpiresAt);
    const login = Number(bru.getVar("reauthenticationLoginTime"));
    expect(end).to.be.above(login + 9 * 60 * 1000);
    expect(end).to.be.at.most(Date.now() + 10 * 60 * 1000);
    bru.setVar("reauthenticationExpiresAt", body.reauthenticationExpiresAt);
  });
}
