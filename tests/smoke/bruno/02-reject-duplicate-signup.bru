meta {
  name: Reject duplicate signup
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/accounts
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

tests {
  test("duplicate signup returns no tokens", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody().accessToken).to.be.undefined;
    expect(res.getBody().refreshToken).to.be.undefined;
  });
}
