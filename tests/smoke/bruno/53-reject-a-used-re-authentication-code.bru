meta {
  name: Reject a used re-authentication code
  type: http
  seq: 53
}

post {
  url: {{baseUrl}}/v1/code-reauthentications
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{reauthenticationAccessToken}}
}

body:json {
  {
    "code": "{{reauthenticationCode}}"
  }
}

tests {
  test("a used code is invalid input", function () {
    expect(res.getStatus()).to.equal(400);
    expect(JSON.stringify(res.getBody())).to.not.include("reauthenticationExpiresAt");
  });
}
