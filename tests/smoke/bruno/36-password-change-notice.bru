meta {
  name: Read password change notice
  type: http
  seq: 36
}

get {
  url: {{mailpitUrl}}/api/v1/message/{{noticeMessageId}}
  body: none
  auth: none
}

script:pre-request {
  const email = bru.getVar("email");
  let messageId;
  for (let attempt = 0; attempt < 40; attempt++) {
    let messages;
    await bru.sendRequest({
      method: "GET",
      url: `${bru.getEnvVar("mailpitUrl")}/api/v1/messages`
    }, function (error, response) {
      if (error) throw error;
      messages = response.data.messages;
    });
    const message = messages.find(item =>
      item.Subject === "FlowSpace password changed" &&
      item.To.some(recipient => recipient.Address === email)
    );
    if (message) {
      messageId = message.ID;
      break;
    }
    await new Promise(resolve => setTimeout(resolve, 250));
  }
  if (!messageId) throw new Error("Password change notice did not arrive");
  bru.setVar("noticeMessageId", messageId);
}

tests {
  test("the notice reaches the verified email without secrets", function () {
    expect(res.getStatus()).to.equal(200);
    const text = res.getBody().Text;
    expect(text).to.not.include(bru.getVar("resetCode"));
    expect(text).to.not.include(bru.getVar("newPassword"));
    expect(text).to.not.include(bru.getVar("password"));
  });
}
