meta {
  name: Log in with new password
  type: http
  seq: 35
}

post {
  url: {{baseUrl}}/v1/password-sessions
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{newPassword}}"
  }
}

tests {
  test("the new password creates a fresh session for the same subject", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.subject).to.equal(bru.getVar("subject"));
    expect(body.emailVerified).to.equal(true);
    expect(body.refreshToken).to.not.equal(bru.getVar("recoveryRefreshToken"));
  });
}
