meta {
  name: Log in with password
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/v1/password-sessions
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

tests {
  test("password login creates a session for the verified account", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.subject).to.equal(bru.getVar("subject"));
    expect(body.emailVerified).to.equal(true);
    expect(body.accessToken).to.be.a("string").and.not.be.empty;
    expect(body.refreshToken).to.be.a("string").and.not.be.empty;
    expect(body.accessToken).to.not.equal(body.refreshToken);
    expect(body.accessTokenExpiresAt).to.be.a("string").and.not.be.empty;
    expect(body.refreshTokenExpiresAt).to.be.a("string").and.not.be.empty;
    expect(body.sessionExpiresAt).to.be.a("string").and.not.be.empty;
    bru.setVar("loginAccessToken", body.accessToken);
    bru.setVar("loginRefreshToken", body.refreshToken);
    bru.setVar("loginSessionExpiresAt", body.sessionExpiresAt);
  });
}
