meta {
  name: Reject password re-authentication without a token
  type: http
  seq: 46
}

post {
  url: {{baseUrl}}/v1/password-reauthentications
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "password": "{{newPassword}}"
  }
}

tests {
  test("password re-authentication needs a bearer access token", function () {
    expect(res.getStatus()).to.equal(401);
    expect(JSON.stringify(res.getBody())).to.not.include("reauthenticationExpiresAt");
  });
}
