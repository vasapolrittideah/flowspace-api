meta {
  name: Request reset code for a missing account
  type: http
  seq: 26
}

post {
  url: {{baseUrl}}/v1/password-reset-codes
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{missingEmail}}"
  }
}

script:pre-request {
  bru.setVar("missingEmail", `missing-${Date.now().toString(36)}@example.test`);
}

tests {
  test("a missing account gets the generic response", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal({ accepted: true });
  });
}
