meta {
  name: Start GitHub re-authentication
  type: http
  seq: 55
}

post {
  url: {{baseUrl}}/v1/provider-reauthentication-attempts
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{reauthenticationAccessToken}}
}

body:json {
  {
    "provider": "PROVIDER_GITHUB"
  }
}

tests {
  test("Identity returns a bound GitHub authorization URL on the login callback route", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(Object.keys(body).sort()).to.deep.equal(["attemptExpiresAt", "attemptToken", "authorizationUrl"]);
    expect(body.attemptToken).to.match(/^[A-Za-z0-9_-]{43}$/);
    const [endpoint, search] = body.authorizationUrl.split("?");
    expect(endpoint).to.equal("https://github.com/login/oauth/authorize");
    const query = new Map(search.split("&").map((pair) => pair.split("=").map((part) => decodeURIComponent(part.replace(/\+/g, " ")))));
    expect(query.get("redirect_uri")).to.equal("http://localhost:8082/v1/provider-login-callbacks/github");
    expect(query.get("code_challenge_method")).to.equal("S256");
    expect(query.get("state")).to.match(/^[A-Za-z0-9_-]{43}$/);
    expect(body.authorizationUrl).to.not.include(body.attemptToken);
    bru.setVar("githubReauthenticationAttemptToken", body.attemptToken);
  });
}
