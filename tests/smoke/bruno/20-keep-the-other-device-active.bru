meta {
  name: Keep the other device active
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/v1/session-refreshes
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "refreshToken": "{{signupRefreshToken}}"
  }
}

tests {
  test("current-device logout leaves the signup session active", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.refreshToken).to.be.a("string").and.not.be.empty;
    expect(body.refreshToken).to.not.equal(bru.getVar("signupRefreshToken"));
    bru.setVar("signupRotatedRefreshToken", body.refreshToken);
  });
}
