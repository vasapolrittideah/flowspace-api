{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "flowspace",
      "folder": "Flowspace",
      "interval": "1m",
      "rules": [
        {
          "uid": "api-error-rate-is-high",
          "title": "API error rate is high",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "(sum by (environment, service) (rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[5m]) or rate(rpc_server_call_duration_seconds_count{rpc_grpc_status_code=~\"2|4|13|14\"}[5m])) / sum by (environment, service) (rate(http_server_request_duration_seconds_count[5m]) or rate(rpc_server_call_duration_seconds_count[5m]))) and (sum by (environment, service) (rate(http_server_request_duration_seconds_count[5m]) or rate(rpc_server_call_duration_seconds_count[5m])) >= 0.1)",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.05
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "5m",
          "labels": {
            "severity": "page"
          },
          "annotations": {
            "summary": "{{ with $values.A }}API error rate is high: {{ humanizePercentage .Value }} of the requests of {{ $labels.service }} end with an error status.{{ else }}API error rate is high: Grafana cannot query Prometheus.{{ end }}",
            "runbook_url": "https://github.com/vasapolrittideah/flowspace-api/blob/main/docs/runbooks/api-error-rate-is-high.md",
            "dashboard_url": "http://localhost:3000/d/flowspace-service-health"
          }
        },
        {
          "uid": "api-latency-is-high",
          "title": "API latency is high",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "max by (environment, service) (histogram_quantile(0.99, sum by (environment, service, le) (rate(http_server_request_duration_seconds_bucket[5m]))) or label_replace(histogram_quantile(0.99, sum by (environment, service, le) (rate(rpc_server_call_duration_seconds_bucket[5m]))), \"rpc\", \"true\", \"\", \"\")) and (sum by (environment, service) (rate(http_server_request_duration_seconds_count[5m]) or rate(rpc_server_call_duration_seconds_count[5m])) >= 0.1)",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        2.5
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "10m",
          "labels": {
            "severity": "ticket"
          },
          "annotations": {
            "summary": "{{ with $values.A }}API latency is high: the p99 server duration of {{ $labels.service }} is {{ humanizeDuration .Value }}.{{ else }}API latency is high: Grafana cannot query Prometheus.{{ end }}",
            "runbook_url": "https://github.com/vasapolrittideah/flowspace-api/blob/main/docs/runbooks/api-latency-is-high.md",
            "dashboard_url": "http://localhost:3000/d/flowspace-service-health"
          }
        },
        {
          "uid": "outbox-events-are-stuck",
          "title": "Outbox events are stuck",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "max by (environment) (identity_outbox_oldest_age_seconds{service=\"identity-worker\"})",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        300
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "5m",
          "labels": {
            "severity": "page"
          },
          "annotations": {
            "summary": "{{ with $values.A }}Outbox events are stuck: the oldest unpublished Identity outbox event is {{ humanizeDuration .Value }} old.{{ else }}Outbox events are stuck: Grafana cannot query Prometheus.{{ end }}",
            "runbook_url": "https://github.com/vasapolrittideah/flowspace-api/blob/main/docs/runbooks/outbox-events-are-stuck.md",
            "dashboard_url": "http://localhost:3000/d/flowspace-event-delivery"
          }
        },
        {
          "uid": "email-consumer-lag-is-not-decreasing",
          "title": "Email consumer lag is not decreasing",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 1200,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "max by (environment) (identity_broker_consumer_lag{service=\"identity-worker\"} and (min_over_time(identity_broker_consumer_lag{service=\"identity-worker\"}[10m]) > 0) and (identity_broker_consumer_lag{service=\"identity-worker\"} >= identity_broker_consumer_lag{service=\"identity-worker\"} offset 10m))",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "labels": {
            "severity": "ticket"
          },
          "annotations": {
            "summary": "{{ with $values.A }}Email consumer lag is not decreasing: the email worker has {{ .Value }} records to consume, not fewer than 10 minutes earlier.{{ else }}Email consumer lag is not decreasing: Grafana cannot query Prometheus.{{ end }}",
            "runbook_url": "https://github.com/vasapolrittideah/flowspace-api/blob/main/docs/runbooks/email-consumer-lag-is-not-decreasing.md",
            "dashboard_url": "http://localhost:3000/d/flowspace-event-delivery"
          }
        },
        {
          "uid": "worker-metrics-are-missing",
          "title": "Worker metrics are missing",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "max by (environment) (absent_over_time(identity_outbox_oldest_age_seconds{environment=\"local\", service=\"identity-worker\"}[5m]) or absent_over_time(identity_broker_consumer_lag{environment=\"local\", service=\"identity-worker\"}[5m]))",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "5m",
          "labels": {
            "severity": "ticket"
          },
          "annotations": {
            "summary": "{{ with $values.A }}Worker metrics are missing: Prometheus has no outbox age or consumer lag sample from identity-worker in the last 5 minutes.{{ else }}Worker metrics are missing: Grafana cannot query Prometheus.{{ end }}",
            "runbook_url": "https://github.com/vasapolrittideah/flowspace-api/blob/main/docs/runbooks/worker-metrics-are-missing.md",
            "dashboard_url": "http://localhost:3000/d/flowspace-event-delivery"
          }
        },
        {
          "uid": "email-delivery-fails",
          "title": "Email delivery fails",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 1200,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "sum by (environment, identity_email_kind) ((sum by (environment, identity_email_kind, outcome) (increase(identity_email_deliveries_total{service=\"identity-worker\", outcome=~\"failed|commit_failed\"}[15m])) > 0) or sum by (environment, identity_email_kind, outcome) (identity_email_deliveries_total{service=\"identity-worker\", outcome=~\"failed|commit_failed\"} unless identity_email_deliveries_total{service=\"identity-worker\", outcome=~\"failed|commit_failed\"} offset 15m))",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "labels": {
            "severity": "ticket"
          },
          "annotations": {
            "summary": "{{ with $values.A }}Email delivery fails: about {{ printf \"%.0f\" .Value }} deliveries of {{ $labels.identity_email_kind }} emails failed in the last 15 minutes.{{ else }}Email delivery fails: Grafana cannot query Prometheus.{{ end }}",
            "runbook_url": "https://github.com/vasapolrittideah/flowspace-api/blob/main/docs/runbooks/email-delivery-fails.md",
            "dashboard_url": "http://localhost:3000/d/flowspace-event-delivery"
          }
        }
      ]
    }
  ]
}
