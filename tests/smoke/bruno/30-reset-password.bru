meta {
  name: Reset password
  type: http
  seq: 30
}

post {
  url: {{baseUrl}}/v1/password-resets
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{email}}",
    "code": "{{resetCode}}",
    "newPassword": "{{newPassword}}"
  }
}

tests {
  test("the current code changes the password and revokes sessions without tokens", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal({ passwordChanged: true, sessionsRevoked: true });
  });
}
