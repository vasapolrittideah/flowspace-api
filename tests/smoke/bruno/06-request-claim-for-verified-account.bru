meta {
  name: Request claim for verified account
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/v1/unverified-account-claim-codes
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{email}}"
  }
}

tests {
  test("a verified account gets the generic response", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().accepted).to.equal(true);
  });
}
