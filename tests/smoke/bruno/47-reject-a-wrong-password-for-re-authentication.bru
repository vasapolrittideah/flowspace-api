meta {
  name: Reject a wrong password for re-authentication
  type: http
  seq: 47
}

post {
  url: {{baseUrl}}/v1/password-reauthentications
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{reauthenticationAccessToken}}
}

body:json {
  {
    "password": "{{password}}-wrong"
  }
}

tests {
  test("a wrong password is invalid input and returns no end time", function () {
    expect(res.getStatus()).to.equal(400);
    expect(JSON.stringify(res.getBody())).to.not.include("reauthenticationExpiresAt");
    expect(JSON.stringify(res.getBody())).to.not.include(bru.getVar("password"));
  });
}
