{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/scripts/git-guard.mjs\"",
            "statusMessage": "Checking review approvals",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
