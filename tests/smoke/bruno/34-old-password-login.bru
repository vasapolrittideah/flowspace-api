meta {
  name: Reject old password after reset
  type: http
  seq: 34
}

post {
  url: {{baseUrl}}/v1/password-sessions
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

tests {
  test("the old password no longer logs in", function () {
    expect(res.getStatus()).to.equal(401);
  });
}
