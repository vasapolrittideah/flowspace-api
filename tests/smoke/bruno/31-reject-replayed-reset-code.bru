meta {
  name: Reject replayed reset code
  type: http
  seq: 31
}

post {
  url: {{baseUrl}}/v1/password-resets
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{email}}",
    "code": "{{resetCode}}",
    "newPassword": "{{newPassword}}"
  }
}

tests {
  test("a consumed code returns the same safe recovery error", function () {
    expect(res.getStatus()).to.equal(400);
    expect(JSON.stringify(res.getBody())).to.equal(bru.getVar("resetCodeError"));
  });
}
