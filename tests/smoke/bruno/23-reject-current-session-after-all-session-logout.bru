meta {
  name: Reject current session after all-session logout
  type: http
  seq: 23
}

post {
  url: {{baseUrl}}/v1/session-refreshes
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "refreshToken": "{{allLogoutRefreshToken}}"
  }
}

tests {
  test("the logout caller cannot refresh", function () {
    expect(res.getStatus()).to.equal(401);
  });
}
