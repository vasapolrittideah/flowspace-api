meta {
  name: Reject a wrong re-authentication code
  type: http
  seq: 51
}

post {
  url: {{baseUrl}}/v1/code-reauthentications
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{reauthenticationAccessToken}}
}

body:json {
  {
    "code": "{{wrongReauthenticationCode}}"
  }
}

script:pre-request {
  const code = bru.getVar("reauthenticationCode");
  bru.setVar("wrongReauthenticationCode", code === "000000" ? "000001" : "000000");
}

tests {
  test("a wrong code is invalid input and returns no end time", function () {
    expect(res.getStatus()).to.equal(400);
    expect(JSON.stringify(res.getBody())).to.not.include("reauthenticationExpiresAt");
  });
}
