meta {
  name: Re-authenticate with code
  type: http
  seq: 52
}

post {
  url: {{baseUrl}}/v1/code-reauthentications
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{reauthenticationAccessToken}}
}

body:json {
  {
    "code": "{{reauthenticationCode}}"
  }
}

tests {
  test("the code keeps the end time of the open window", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal({ reauthenticationExpiresAt: bru.getVar("reauthenticationExpiresAt") });
  });
}
