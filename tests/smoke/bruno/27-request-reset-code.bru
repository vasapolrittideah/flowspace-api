meta {
  name: Request reset code
  type: http
  seq: 27
}

post {
  url: {{baseUrl}}/v1/password-reset-codes
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{email}}"
  }
}

tests {
  test("an eligible account gets the same generic response", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal({ accepted: true });
  });
}
